# ------------------------------------------------------------------
# PhotoLink 環境変数の見本
#   このファイルを .env.local にコピーし、値を設定してください。
#   cp .env.example .env.local
#
# ※ VITE_ で始まる値はブラウザに配信されます。
#   ここには「公開してよいキー (anon / publishable key)」だけを書きます。
#   service_role キー (secret key) は絶対に書かないでください。
# ------------------------------------------------------------------

# Supabase ダッシュボード > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase ダッシュボード > Project Settings > API Keys > anon public (または publishable key)
VITE_SUPABASE_ANON_KEY=your-anon-key

# 招待 URL などに使うアプリの公開 URL (末尾スラッシュなし)。未設定ならブラウザの URL を使用
VITE_APP_URL=http://localhost:5173
